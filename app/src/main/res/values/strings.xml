    <string name="mode_three_desc">屏幕底部显示返回、主页、多任务三个按键</string>
    <string name="mode_two_desc">返回键与上滑手势混合的导航方式</string>
    <string name="mode_gesture_desc">从屏幕底部上滑回到桌面，从边缘侧滑返回</string>

    <string name="switch_to_gesture">切换为手势导航</string>
    <string name="switch_to_three">切换为三键导航</string>

    <string name="permission_title">需要一次授权</string>
    <string name="permission_desc">Android 不允许普通应用直接修改系统导航方式。请用数据线连接电脑，执行下面的命令完成授权。只需一次，之后无需电脑。</string>
    <string name="adb_command">adb shell pm grant %1$s android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="copy_command">复制命令</string>
    <string name="recheck">重新检查</string>
    <string name="root_grant">没有电脑？尝试 Root 授权</string>

    <string name="shizuku_title">需要 Shizuku</string>
    <string name="shizuku_desc">荣耀 / 华为系统不允许普通应用直接切换导航方式。安装并启动 Shizuku 后授予权限，即可一键切换。</string>
    <string name="shizuku_steps">1. 安装 Shizuku\n2. 按 Shizuku 内引导启动服务\n3. 回到本页点击“授予权限”</string>
